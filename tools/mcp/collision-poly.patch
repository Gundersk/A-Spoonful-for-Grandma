 // ─── Check 2: Required Fields ────────────────────────────────
 
+/** Check every stored polygon, including frames in animation subfolders. */
+function checkCollisionPolygons(objects: Map<string, ObjectType>, errors: IntegrityIssue[]): void {
+  function check(frame: unknown, entity: string): void {
+    if (!isRecord(frame)) return;
+    // Editor-saved rectangular frames can omit collisionPoly entirely, even
+    // with useCollisionPoly:true. An explicit empty polygon is different.
+    if (frame.collisionPoly === undefined) return;
+    const points = isRecord(frame.collisionPoly) ? frame.collisionPoly.points : undefined;
+    let reason = '';
+    if (!Array.isArray(points) || points.length < 6 || points.length % 2 !== 0) {
+      reason = 'requires at least three (x,y) pairs (an even array of at least six numbers)';
+    } else if (!points.every(p => typeof p === 'number' && Number.isFinite(p))) {
+      reason = 'coordinates must be finite numbers';
+    } else {
+      const vertices = Array.from({ length: points.length / 2 }, (_, i) => [points[2 * i], points[2 * i + 1]]);
+      const distinct = [...new Map(vertices.map(p => [JSON.stringify(p), p])).values()];
+      if (distinct.length < 3) reason = 'requires at least three distinct vertices';
+      else {
+        const [a, b] = distinct;
+        if (!distinct.some(c => (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]) !== 0)) {
+          reason = 'vertices are collinear (zero-area polygon)';
+        }
+      }
+    }
+    if (reason) errors.push({ check: 'collision-poly', entity,
+      message: `Invalid collisionPoly.points: ${reason}.`,
+      suggestion: 'Restore the intended polygon; a rectangular frame uses [0,0,1,0,1,1,0,1].' });
+  }
+  for (const [name, obj] of objects) {
+    if (obj['plugin-id'] === 'Sprite') {
+      for (const anim of everyAnimation<{ name?: unknown; frames?: unknown }>(obj.animations)) {
+        if (Array.isArray(anim.frames)) anim.frames.forEach((frame, i) =>
+          check(frame, `objectTypes/${name}/animation:${String(anim.name)}/frame:${i}`));
+      }
+    } else if (obj['plugin-id'] === 'TiledBg') check(obj.image, `objectTypes/${name}/image`);
+  }
+}
+
